[appindicator]
compact-mode-enabled=false
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=0

[blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000000'>, 'params': <{'radius': <30>, 'brightness': <0.59999999999999998>}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000001'>, 'params': <{'radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'corner'>, 'id': <'effect_000000000002'>, 'params': <{'radius': <24>}>}>]>}, 'pipeline_05798735111392': {'name': <'Dock'>, 'effects': <[<{'type': <'color'>, 'id': <'effect_72345906052476'>, 'params': <@a{sv} {}>}>]>}}
rounded-blur-found=false
settings-version=2

[blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=false
brightness=1.0
pipeline='pipeline_default'
sigma=30
static-blur=false
style-dash-to-dock=0
unblur-in-overview=false

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'

[blur-my-shell/panel]
blur=false
brightness=0.59999999999999998
pipeline='pipeline_default'
sigma=30

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
blur=true
brightness=0.59999999999999998
sigma=30

[caffeine]
cli-toggle=false
countdown-timer=0
enable-fullscreen=false
indicator-position-max=1
user-enabled=false

[display-brightness-ddcutil]
button-location=1
ddcutil-binary-path='/usr/bin/ddcutil'
ddcutil-sleep-multiplier=40.0
decrease-brightness-shortcut=['<Control>XF86MonBrightnessDown']
hide-system-indicator=true
increase-brightness-shortcut=['<Control>MonBrightnessUp']
only-all-slider=false
position-system-menu=3.0
show-all-slider=false
show-display-name=false
show-internal-slider=false
show-osd=true
show-value-label=false
step-change-keyboard=2.0
vcp-6b=true

[vitals]
hot-sensors=['_processor_usage_', '_memory_usage_', '__temperature_avg__']
position-in-panel=0
show-gpu=true
